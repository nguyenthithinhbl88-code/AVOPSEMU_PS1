<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\ui\AVOPSEMU.Wpf\bin\$(Configuration)\net10.0-windows\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AssemblyName>AVOPSEMU.InteropTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ui\AVOPSEMU.Wpf\Interop\*.cs"
             Link="Interop\%(Filename)%(Extension)" />
    <Compile Include="..\ui\AVOPSEMU.Wpf\Library\*.cs"
             Link="Library\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
